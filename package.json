{
  "name": "bigfeels-mem",
  "version": "0.1.0",
  "description": "Optional OpenClaw adapter for the host-neutral bigfeels memory engine",
  "type": "module",
  "files": [
    "src/bigfeels_mem/*.py",
    "src/bigfeels_mem/static",
    "adapters/openclaw/adapter.js",
    "adapters/openclaw/index.js",
    "adapters/openclaw/tools.js",
    "adapters/openclaw/bridge.py",
    "adapters/openclaw/openclaw.plugin.json",
    "adapters/openclaw/package.json",
    "adapters/openclaw/README.md",
    "openclaw.plugin.json",
    "INSTALL.md",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test adapters/openclaw/test.mjs adapters/openclaw/tools.test.mjs tests/*.test.mjs"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.11"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./adapters/openclaw/index.js"
    ],
    "install": {
      "localPath": ".",
      "defaultChoice": "local",
      "minHostVersion": ">=2026.6.11"
    },
    "compat": {
      "pluginApi": ">=2026.6.11"
    },
    "build": {
      "openclawVersion": "2026.6.11"
    }
  },
  "engines": {
    "node": ">=22.19"
  }
}
