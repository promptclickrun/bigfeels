{
  "id": "bigfeels-mem",
  "name": "bigfeels memory",
  "description": "Native, agent-installed evidence-based memory for OpenClaw.",
  "kind": "memory",
  "activation": {
    "onStartup": true,
    "onCapabilities": ["hook", "tool"]
  },
  "contracts": {
    "tools": [
      "bigfeels_search",
      "bigfeels_inspect",
      "bigfeels_remember",
      "bigfeels_correct",
      "bigfeels_forget_preview",
      "bigfeels_forget",
      "bigfeels_status"
    ]
  },
  "uiHints": {
    "mode": { "label": "Storage mode", "help": "Native local storage is the default. HTTP is an advanced compatibility mode." },
    "ownerSpace": { "label": "Owner space", "placeholder": "owner" },
    "projectSpaces": { "label": "Linked project spaces", "advanced": true },
    "writeSpace": { "label": "Capture space", "advanced": true },
    "primaryAgentId": { "label": "Primary agent ID", "placeholder": "main" },
    "budget": { "label": "Recall token budget", "advanced": true },
    "timeoutMs": { "label": "HTTP timeout (ms)", "advanced": true },
    "processTimeoutMs": { "label": "Native worker timeout (ms)", "advanced": true },
    "dataDir": { "label": "Native data directory", "advanced": true },
    "pythonPath": { "label": "Python executable", "advanced": true },
    "url": { "label": "Legacy service URL", "placeholder": "http://127.0.0.1:8765", "advanced": true },
    "token": { "label": "Legacy bearer token", "sensitive": true, "advanced": true },
    "autoCapture": { "label": "Automatic capture" },
    "autoRecall": { "label": "Automatic recall" }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": { "type": "string", "enum": ["native", "http"], "default": "native" },
      "ownerSpace": { "type": "string", "minLength": 1, "default": "owner" },
      "projectSpaces": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
      "writeSpace": { "type": "string" },
      "primaryAgentId": { "type": "string", "minLength": 1, "default": "main" },
      "budget": { "type": "integer", "minimum": 1, "maximum": 4000, "default": 800 },
      "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 750 },
      "processTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000, "default": 30000 },
      "dataDir": { "type": "string", "minLength": 1 },
      "pythonPath": { "type": "string", "minLength": 1, "default": "python3" },
      "url": { "type": "string", "minLength": 1 },
      "token": { "type": "string", "minLength": 1 },
      "autoCapture": { "type": "boolean", "default": true },
      "autoRecall": { "type": "boolean", "default": true }
    }
  }
}
