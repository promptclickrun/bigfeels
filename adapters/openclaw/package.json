{
  "name": "@bigfeels/openclaw-memory",
  "version": "0.1.0",
  "description": "OpenClaw native lifecycle adapter for the bigfeels memory core",
  "type": "module",
  "exports": "./index.js",
  "files": [
    "adapter.js",
    "index.js",
    "tools.js",
    "bridge.py",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.6.11"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "install": {
      "localPath": ".",
      "defaultChoice": "local",
      "minHostVersion": ">=2026.6.11"
    },
    "compat": {
      "pluginApi": ">=2026.6.11"
    },
    "build": {
      "openclawVersion": "2026.6.11"
    }
  },
  "scripts": {
    "test": "node --test test.mjs tools.test.mjs"
  },
  "engines": {
    "node": ">=22.19"
  }
}
