include LICENSE README.md CONTRIBUTING.md INSTALL.md
include __init__.py plugin.yaml package.json openclaw.plugin.json
recursive-include docs *.md
recursive-include adapters *.py *.js *.mjs *.json *.md *.yaml
recursive-include benchmarks *.py *.md *.json
exclude benchmarks/harness/results.json benchmarks/harness/report.md
prune benchmarks/results
recursive-include tests *.py
recursive-include tests *.mjs
recursive-include src/bigfeels_mem/static *

include cloud/README.md cloud/build.py cloud/pyproject.toml cloud/uv.lock cloud/package.json cloud/package-lock.json cloud/wrangler.jsonc cloud/.dev.vars.example
include cloud/src/worker.py cloud/src/database.py
include scripts/test-cloud.py
